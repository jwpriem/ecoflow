{
  "name": "ecoflow-energy",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "generate:app": "NUXT_APP_BUILD=1 nuxt generate",
    "ios:build": "NUXT_PUBLIC_API_BASE=${NUXT_PUBLIC_API_BASE:-https://www.wattswise.eu} npm run generate:app && cap sync ios",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "test": "vitest run",
    "test:live": "vitest run tests/ecoflow.live.test.ts",
    "typecheck": "nuxt typecheck"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@electric-sql/pglite": "^0.3.16",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.1.0"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/status-bar": "8.0.4",
    "@sentry/node": "^11.10.0",
    "@sentry/vue": "^11.10.0",
    "chart.js": "^4.5.0",
    "drizzle-orm": "^0.45.0",
    "marked": "^18.1.2",
    "mqtt": "^5.16.1",
    "nodemailer": "^10.2.1",
    "nuxt": "^4.2.0",
    "postgres": "^3.4.7",
    "vue": "^3.5.0",
    "vue-chartjs": "^5.3.2",
    "vue-router": "^4.5.0",
    "web-push": "^3.6.7",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": "22.x"
  }
}
