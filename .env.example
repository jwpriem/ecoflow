# Neon: use the pooled connection string (…-pooler…), sslmode=require
NUXT_DATABASE_URL=postgres://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/ecoflow?sslmode=require
# 32 random bytes, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NUXT_ENCRYPTION_KEY=
# Set to false on extra instances so only one runs the collectors and the battery control loop
NUXT_JOBS_ENABLED=true
# Only for the Capacitor build: URL of the deployed API
NUXT_PUBLIC_API_BASE=

# Used by `npm run db:seed`
SEED_EMAIL=me@example.com
SEED_PASSWORD=change-me
SEED_DAYS=30
