# Neon: use the pooled connection string (…-pooler…), sslmode=require
NUXT_DATABASE_URL=postgres://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/ecoflow?sslmode=require
# 32 random bytes, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NUXT_ENCRYPTION_KEY=
# Set to false on extra instances so only one runs the collectors and the battery control loop
NUXT_JOBS_ENABLED=true
# Public URL of the server (https://…). The SolarEdge redirect URI is <this>/api/integrations/solaredge/callback.
# Leave empty to take it from the request; Settings shows the exact value to register.
NUXT_APP_URL=
# Web Push (optional): generated and stored in the database when empty. npx web-push generate-vapid-keys
NUXT_VAPID_PUBLIC_KEY=
NUXT_VAPID_PRIVATE_KEY=
# Contact Apple/Google can reach about the pushes; defaults to mailto:<account email>
NUXT_VAPID_SUBJECT=
# Email over SMTP (SMTP2GO, EU region). Leave the host empty to print emails to the console instead of sending them.
NUXT_EMAIL_SMTP_HOST=
NUXT_EMAIL_SMTP_PORT=587
NUXT_EMAIL_SMTP_USER=
NUXT_EMAIL_SMTP_PASSWORD=
NUXT_EMAIL_FROM=WattsWise <hello@wattswise.eu>
# Only for the Capacitor build: URL of the deployed API
NUXT_PUBLIC_API_BASE=

# Only for `npm run test:live`: a live check of the EcoFlow developer API (the app itself reads the keys from Settings)
ECOFLOW_ACCESS_KEY=
ECOFLOW_SECRET_KEY=
